<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sicost.common.security.AccountKeyMapper">
  <select id="hasEncryptedAccounts" resultType="boolean">
    SELECT EXISTS(SELECT 1 FROM tb_bs_clnt WHERE acct_no_enc IS NOT NULL)
  </select>
</mapper>
